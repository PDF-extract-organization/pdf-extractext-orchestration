# Copia este archivo a `.env` y rellena los valores. El .env real nunca se commitea.

# --- MongoDB (obligatorias) ---
# Mongo arranca con autenticación. Solo el servicio summaries recibe estas credenciales.
MONGO_ROOT_USERNAME=pdfextract
# Va dentro de la URL de conexión: evita los caracteres @ : / ? # % y los no ASCII.
MONGO_ROOT_PASSWORD=cambia-esta-clave

# --- OpenRouter (opcional) ---
# Clave del servidor: la que se usa cuando el usuario no añade la suya desde la
# interfaz (botón ⚙️ → Añadir modelo). Sin ninguna de las dos, generar un resumen
# responde 503 explicando las dos opciones. Crea una gratis en https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Modelo por defecto si Consul no tiene summarizer/model.
OPENROUTER_MODEL=openrouter/free

# --- Opcionales ---
# Versión de las imágenes de ghcr. Por defecto, latest.
# TAG=latest
# Dominio por el que entra Traefik. Por defecto, pdf.localhost.
# APP_HOST=pdf.localhost
# Dominio de la interfaz y la API de Consul. Por defecto, consul.localhost.
# CONSUL_HOST=consul.localhost
# Tamaño máximo por PDF en megabytes.
# MAX_FILE_SIZE_MB=10
